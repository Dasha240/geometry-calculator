import math

a = 0.1
b = 0.9
step = 0.05

n = int((b - a) / step) + 1

print("x\t\t y")
print("-" * 25)

for i in range(n):
    x = a + i * step

    exponent = x - math.log(3 * x)
    term1 = math.exp(exponent * math.log(4))
    term2 = math.log(3 * x) / math.log(4)
    
    y = math.sin(term1) + term2
    
    print(f"{x:.2f}\t\t {y:.5f}")
