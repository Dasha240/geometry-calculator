def main():
    # Запрашиваем количество чисел
    N = int(input("Введите количество целых чисел (N): "))
    
    # Проверка на корректность ввода
    if N <= 0:
        print("Количество чисел должно быть положительным.")
        return

    # Запрашиваем числа
    numbers = []
    for i in range(N):
        num = int(input(f"Введите целое число {i + 1}: "))
        numbers.append(num)

    # Подсчитываем количество отрицательных чисел
    negative_count = sum(1 for number in numbers if number < 0)

    # Выводим результат
    print(f"Количество отрицательных элементов: {negative_count}")

if __name__ == "__main__":
    main()
